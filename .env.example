# ==========================================
# ZE-Dashboard Configuration Example
# Copy this file to .env and adjust values
# ==========================================

# --- SECURITY (CRITICAL) ---
# Secret key used for signing JWT tokens. 
# Generate a secure key using `openssl rand -hex 32` or similar.
SECRET_KEY=

# --- DATABASE ---
# Connection string for the database.
# Default is a local SQLite file mounted in the container.
DATABASE_URL=sqlite:///./data/ze_dashboard.db

# --- BACKEND SETTINGS ---
# Token expiration time in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Required on the very first start (at least 12 characters). It is never logged
# and is ignored once the admin account exists.
ADMIN_PASSWORD=

# --- FRONTEND SETTINGS ---
# URL of the backend API. 
# For Docker Nginx setup, '/api' is the correct relative path.
VITE_API_URL=/api

# --- OPERATIONAL SETTINGS ---
RATE_LIMIT_LOGIN=5/minute
# Limits for document creation per client IP, aggregate upload storage, and file count.
RATE_LIMIT_UPLOAD=20/hour
MAX_UPLOAD_STORAGE_MB=5120
MAX_UPLOAD_FILES=10000

# Secure deployment defaults. For local HTTP development only, explicitly set
# both values to false and use a non-production SECRET_KEY.
PRODUCTION=true
SECURE_COOKIES=true
DEBUG_MODE=false
# Calendar-day and monthly reporting boundaries.
BUSINESS_TIMEZONE=Europe/Berlin
# Docker exposes the frontend only on 127.0.0.1:${FRONTEND_PORT}; put a TLS
# reverse proxy in front of it for production. Run the interactive helper with
# `sudo python3 scripts/setup_nginx_proxy.py` on Debian/Ubuntu.
FRONTEND_PORT=8080
# Dedicated Docker network used as the backend's trusted proxy boundary. If the
# subnet must be changed because of a routing conflict, update both values.
ATLAS_NETWORK_SUBNET=172.30.253.0/24
FORWARDED_ALLOW_IPS=172.30.253.0/24

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# --- AI FEATURES (Optional) ---
# Mistral AI API Key für automatische PDF-Analyse und Vertrags-Chatbot
# Hol dir einen Key auf https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
# Resource limits for untrusted PDFs and model context.
MISTRAL_MAX_PDF_PAGES=100
MISTRAL_MAX_IMAGE_PDF_PAGES=8
MISTRAL_MAX_OCR_CHARACTERS=100000
MISTRAL_REQUEST_TIMEOUT_SECONDS=300
# Chat and OCR always use https://api.mistral.ai with MISTRAL_API_KEY.
# Option 1 (default): Mistral Medium 3.5 with thinking enabled.
MISTRAL_CHAT_MODEL=mistral-medium-3-5
# Medium 3.5 supports none or high; high is its maximum reasoning effort.
MISTRAL_REASONING_EFFORT=high
# auto (also the default when unset): Medium 3.5 -> high, GLM 5.3 -> max.
# Option 2: GLM 5.3 hosted by Mistral. Replace the model/effort above with:
# MISTRAL_CHAT_MODEL=zai-glm-5-3
# The alias shown in Mistral Studio works too: MISTRAL_CHAT_MODEL=zai-glm-latest
# MISTRAL_REASONING_EFFORT=max
# MISTRAL_USE_OCR=true
# GLM 5.3 accepts text only: PDFs require Mistral OCR (enabled below).
# max is sent unchanged to Mistral for GLM 5.3; Medium 3.5 rejects max.
# https://docs.mistral.ai/models/zai-glm-5-3
# See README for reasoning configuration details.
MISTRAL_OCR_MODEL=mistral-ocr-4-0
MISTRAL_OCR_TABLE_FORMAT=markdown
MISTRAL_OCR_INCLUDE_BLOCKS=true
MISTRAL_OCR_CONFIDENCE_GRANULARITY=page
MISTRAL_USE_OCR=true
MISTRAL_DOCUMENT_PROCESSING_ENABLED=true

# --- PUBLIC NOTICE-PERIOD RESEARCH (separate from document processing) ---
# disabled | mistral | openai. Only explicitly entered, confirmed public search
# text is sent. No document/OCR/chat/title/description is attached automatically.
NOTICE_RESEARCH_PROVIDER=disabled
# For mistral: mistral-medium-latest (GLM is not used for hosted web search).
# For openai: e.g. gpt-5.5 with Responses web_search.
# Empty selects the provider-specific default above, never MISTRAL_CHAT_MODEL.
NOTICE_RESEARCH_MODEL=
# Optional separate key; otherwise uses MISTRAL_API_KEY or OPENAI_API_KEY.
NOTICE_RESEARCH_API_KEY=
OPENAI_API_KEY=
